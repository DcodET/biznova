{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1240px",
      "wideSize": "1400px"
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": true,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "name": "Navy Primary (الكحلي الأساسي)",
          "slug": "primary-navy",
          "color": "#0C1E3C"
        },
        {
          "name": "Navy Dark (كحلي ليلي)",
          "slug": "primary-navy-dark",
          "color": "#071326"
        },
        {
          "name": "Navy Light (كحلي فاتح)",
          "slug": "primary-navy-light",
          "color": "#162E56"
        },
        {
          "name": "Energy Orange (البرتقالي الحيوي)",
          "slug": "secondary-orange",
          "color": "#F47521"
        },
        {
          "name": "Pure White (أبيض ناصع)",
          "slug": "pure-white",
          "color": "#FFFFFF"
        },
        {
          "name": "Soft Off-White (أوف وايت ناعم)",
          "slug": "soft-offwhite",
          "color": "#F8FAFC"
        },
        {
          "name": "Muted Text (رمادي داكن نصوص)",
          "slug": "text-muted",
          "color": "#526484"
        },
        {
          "name": "Border Subtle (حدود رقيقة)",
          "slug": "border-subtle",
          "color": "#E2E8F0"
        }
      ],
      "gradients": [
        {
          "name": "BIZNOVA Energy Gradient",
          "slug": "orange-glow-gradient",
          "gradient": "linear-gradient(135deg, #F47521 0%, #FF9F43 100%)"
        },
        {
          "name": "BIZNOVA Navy Corporate Gradient",
          "slug": "navy-deep-gradient",
          "gradient": "linear-gradient(135deg, #0C1E3C 0%, #162E56 100%)"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "name": "Cairo (القاهرة)",
          "slug": "cairo",
          "fontFamily": "'Cairo', system-ui, -apple-system, sans-serif"
        },
        {
          "name": "Readex Pro",
          "slug": "readex-pro",
          "fontFamily": "'Readex Pro', 'Cairo', sans-serif"
        }
      ],
      "fontSizes": [
        { "name": "Small (صغير)", "slug": "small", "size": "14px" },
        { "name": "Base (قياسي)", "slug": "base", "size": "16px" },
        { "name": "Medium (متوسط)", "slug": "medium", "size": "20px" },
        { "name": "Large (كبير)", "slug": "large", "size": "28px" },
        { "name": "Extra Large (ضخم)", "slug": "x-large", "size": "38px" },
        { "name": "Hero Title (عنوان رئيسي)", "slug": "hero-title", "size": "48px" }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "%", "vh", "vw"],
      "spacingScale": {
        "steps": 0
      }
    },
    "shadow": {
      "presets": [
        {
          "name": "Soft Card Shadow",
          "slug": "card-soft",
          "shadow": "0 4px 14px rgba(12, 30, 60, 0.07)"
        },
        {
          "name": "Hover Lift Shadow",
          "slug": "hover-lift",
          "shadow": "0 12px 30px rgba(12, 30, 60, 0.12)"
        },
        {
          "name": "Orange Glow",
          "slug": "orange-glow",
          "shadow": "0 10px 25px rgba(244, 117, 33, 0.35)"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--pure-white)",
      "text": "var(--wp--preset--color--primary-navy)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--cairo)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.7"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--readex-pro)",
          "fontWeight": "700"
        },
        "color": {
          "text": "var(--wp--preset--color--primary-navy)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--secondary-orange)"
        },
        ":hover": {
          "color": {
            "text": "#E05F0C"
          }
        }
      },
      "button": {
        "border": {
          "radius": "12px"
        },
        "color": {
          "background": "var(--wp--preset--color--secondary-orange)",
          "text": "var(--wp--preset--color--pure-white)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--cairo)",
          "fontSize": "16px",
          "fontWeight": "700"
        },
        "spacing": {
          "padding": {
            "top": "13px",
            "bottom": "13px",
            "left": "28px",
            "right": "28px"
          }
        }
      }
    }
  }
}
